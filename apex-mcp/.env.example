# --- Ontología (Neo4j local del paso 1) ---
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=apexpassword

# --- Fuente real (Postgres tras la VPN; requiere vpn-connect + vpn-forward) ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CLIENT_DB

# --- Guardrails ---
QUERY_TIMEOUT_MS=15000
MAX_ROWS=500
SOURCE_MAX_CONCURRENCY=4
# Datos clínicos: muestreo de filas crudas apagado por defecto
ALLOW_ROW_SAMPLING=false

RUST_LOG=apex_mcp=info

# --- Transporte (conexión fácil por URL + key) ---
# stdio (default) para clientes locales; http para compartir por red
MCP_TRANSPORT=stdio
MCP_PORT=8977
# Requerida en modo http. Genera una con: openssl rand -hex 24  (o `make mcp-key`)
MCP_API_KEY=CHANGE_ME
