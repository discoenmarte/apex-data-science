# Which LLM drives the `make ask` / `make chat` agent.
# Copy this file to `llm.env` and uncomment ONE block. Env vars override this file.
#   cp llm.env.example llm.env
# The MCP server does NOT use this — it's only for the terminal client (tools/ask.py).

# ── Ollama, local & free (DEFAULT — nothing to configure) ──────────────
# Run `make llm-setup` once. Change the model to any you've `ollama pull`ed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-oss:20b
LLM_API_KEY=ollama

# ── LM Studio (local GUI, OpenAI-compatible server on :1234) ───────────
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-loaded-model-name
# LLM_API_KEY=lm-studio

# ── vLLM / llama.cpp / any self-hosted OpenAI-compatible server ────────
# LLM_BASE_URL=http://YOUR_HOST:8000/v1
# LLM_MODEL=the-served-model-id
# LLM_API_KEY=not-needed

# ── OpenAI ─────────────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# ── Where the apex MCP server is (only change if not localhost:8977) ────
# MCP_URL=http://localhost:8977/mcp
# MCP_KEY=...    # defaults to MCP_API_KEY from apex-mcp/.env
