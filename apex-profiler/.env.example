# --- Postgres (llega vía port-forward del contenedor VPN) ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
DB_SCHEMAS=public

# --- Perfilado ---
PROFILE_CONCURRENCY=8
RUST_LOG=apex_profiler=info

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=apexpassword

# --- Flags ---
SKIP_NEO4J=false
